PORT=5001
CLIENT_URL=http://localhost:3000

DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Database target selection. Leave unset (or "postgres") for normal
# operation — PostgreSQL/Neon is the production path.
#
# "cockroach" is for the compatibility evaluation ONLY (see
# docs/COCKROACHDB_MIGRATION_AND_CUTOVER.md). Cockroach-only migrations and
# destructive tests refuse to run unless this is explicitly "cockroach", so
# they can never target Neon production by accident.
DATABASE_DIALECT=postgres

# Deliberately a SEPARATE variable from DATABASE_URL so the Cockroach
# staging cluster can never be reached through the production connection
# path. Never commit a real value.
COCKROACH_DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-secret

GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
CHAT_AI_TIMEOUT_MS=18000
CHAT_AI_ATTEMPTS=1
CHAT_AI_MAX_QUEUE_WAIT_MS=3000
CHAT_AI_MAX_RETRY_AFTER_MS=0
CHAT_AI_MAX_MODELS=3
CHAT_AI_MAX_OUTPUT_TOKENS=900
CHAT_AI_TEMPERATURE=0.2
SUMMARY_AI_TIMEOUT_MS=12000
SUMMARY_AI_ATTEMPTS=1
SUMMARY_AI_MAX_QUEUE_WAIT_MS=3000
SUMMARY_AI_MAX_RETRY_AFTER_MS=0
SUMMARY_AI_MAX_MODELS=2
SUMMARY_AI_MAX_OUTPUT_TOKENS=1200
SUMMARY_AI_TEMPERATURE=0.1
SUGGESTED_QUESTIONS_AI_TIMEOUT_MS=8000
SUGGESTED_QUESTIONS_AI_ATTEMPTS=1
SUGGESTED_QUESTIONS_AI_MAX_QUEUE_WAIT_MS=2000
SUGGESTED_QUESTIONS_AI_MAX_RETRY_AFTER_MS=0
SUGGESTED_QUESTIONS_AI_MAX_MODELS=2
SUGGESTED_QUESTIONS_AI_MAX_OUTPUT_TOKENS=350
SUGGESTED_QUESTIONS_AI_TEMPERATURE=0.2
COMPARISON_AI_TIMEOUT_MS=10000
COMPARISON_AI_ATTEMPTS=1
COMPARISON_AI_MAX_QUEUE_WAIT_MS=4000
COMPARISON_AI_MAX_RETRY_AFTER_MS=0
COMPARISON_AI_MAX_MODELS=3
COMPARISON_AI_MAX_OUTPUT_TOKENS=2000
COMPARISON_AI_TEMPERATURE=0.1
COMPARISON_PASSAGE_CHAR_LIMIT=1000
# Keep comparison usable during transient Gemini/circuit/rate failures by
# returning a clearly marked grounded extractive comparison instead of a 503.
COMPARISON_ALLOW_EXTRACTIVE_FALLBACK=true
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_PROVIDER=gemini
EMBEDDING_BATCH_TOKEN_BUDGET=240000

# Optional legacy OpenAI-compatible fallback. Leave empty when Gemini is primary.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_FALLBACK_MODEL=
OPENAI_OCR_MODEL=
OPENAI_EMBEDDING_MODEL=

PINECONE_API_KEY=replace-with-pinecone-api-key
PINECONE_INDEX_NAME=rashtram-bills
PINECONE_ACT_INDEX_NAME=rashtram-acts
# Optional. If omitted, domain-separated operational tokens are derived from
# existing server-only secrets. The underlying secrets are never sent.
CATALOG_INGESTION_SECRET=
CRON_SECRET=
PINECONE_NAMESPACE=gemini-embedding-001-768-v1

# Safe corpus worker defaults. Increase only after reviewing provider latency,
# source throttling, failure rate, and memory in process:status.
PROCESSING_CONCURRENCY=3
PROCESSING_SOURCE_CONCURRENCY=2

# Database capacity guard. Keep limits provider-reported where available.
DATABASE_STORAGE_WARNING_PERCENT=70
DATABASE_STORAGE_PAUSE_PERCENT=82
DATABASE_STORAGE_CRITICAL_PERCENT=90
DATABASE_STORAGE_MIN_HEADROOM_BYTES=67108864
DATABASE_STORAGE_HIGH_GROWTH_BYTES_PER_READY_DOCUMENT=131072
# DATABASE_STORAGE_MAX_BYTES=

# Optional S3-compatible artifact storage. Leaving provider disabled or any
# required field absent keeps all object-storage writes disabled.
OBJECT_STORAGE_PROVIDER=disabled
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PUBLIC_BASE_URL=
# Required by some S3-compatible providers such as local MinIO.
OBJECT_STORAGE_FORCE_PATH_STYLE=false
