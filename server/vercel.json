{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "server.js": {
      "includeFiles": "assets/fonts/**",
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/internal/cron/ingest?source=pib",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/internal/cron/maintenance",
      "schedule": "15 1 * * *"
    }
  ]
}
